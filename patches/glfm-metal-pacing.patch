+    (void)inOutputTime;
+    (void)flagsIn;
+    (void)flagsOut;
+    GLFMMetalView *view = (__bridge GLFMMetalView *)displayLinkContext;
+    [view performSelectorOnMainThread:@selector(glfmDisplayLinkTick) withObject:nil waitUntilDone:NO];
+    return kCVReturnSuccess;
+}
